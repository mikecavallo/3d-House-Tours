    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.server }}/history/{{ $json.prompt_id }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Get history",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        140
      ],
      "id": "c38cde96-e464-5d0e-a513-a401ddb9def6"
    },
    {
      "parameters": {
        "jsCode": "// Classify one job from GET /history/<id>: pending, error or done (+ the files to download).\nconst job = $('Wait for job').item.json;\nconst hist = $input.item.json || {};\nconst entry = hist[job.prompt_id];\nif (!entry) return { json: Object.assign({}, job, { state: 'pending' }) };\nconst st = entry.status || {};\nif (st.status_str === 'error') {\n  const errs = (st.messages || []).filter((m) => m[0] === 'execution_error').map((m) => `${m[1].node_type} (${m[1].node_id}): ${(m[1].exception_message || '').trim()}`);\n  return { json: Object.assign({}, job, { state: 'error', error: errs.join('; ') || 'unknown ComfyUI error' }) };\n}\nif (st.completed === false) return { json: Object.assign({}, job, { state: 'pending' }) };\nconst downloads = [];\nfor (const [label, nodeId] of Object.entries(job.titles)) {\n  const out = (entry.outputs || {})[nodeId] || {};\n  const f = [].concat(out.images || [], out.videos || [], out.gifs || []).find((x) => x && x.filename && x.type === 'output');\n  if (f) {\n    const ext = f.filename.slice(f.filename.lastIndexOf('.'));\n    downloads.push({ filename: f.filename, subfolder: f.subfolder || '', type: f.type, dest: `${job.dir}/${job.name}${label ? '-' + label : ''}${ext}` });\n  }\n}\nif (!downloads.length) return { json: Object.assign({}, job, { state: 'error', error: 'job finished but saved nothing' }) };\nreturn { json: Object.assign({}, job, { state: 'done', downloads }) };\n",
        "mode": "runOnceForEachItem"
      },
