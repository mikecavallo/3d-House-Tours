        "jsCode": "const j = Object.assign({}, $('Build prompt').item.json);\ndelete j.prompt_body; delete j.uploads;\nreturn { json: Object.assign(j, { prompt_id: $json.prompt_id, mode: 'collect' }) };",
        "mode": "runOnceForEachItem"
