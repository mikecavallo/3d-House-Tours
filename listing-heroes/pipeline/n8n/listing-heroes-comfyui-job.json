      ],
      "id": "b1c683b9-7abe-597e-a725-10b515685c4d",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Parse every JSON file read by \"Read workflow files\" into { file, data }.\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  out.push({ json: { file: items[i].binary.data.fileName, data: JSON.parse(buf.toString('utf8')) } });\n}\nreturn out;\n"
      },
      "name": "Parse workflow files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        460
      ],
      "id": "e9ff478e-b9f7-5c98-8004-02ae099f3cda"
    },
    {
      "parameters": {
        "jsCode": "// One item per photo/video the jobs need uploaded to ComfyUI (ji = index of the job).\nconst manifest = $('Parse workflow files').all().find((x) => x.json.file === 'manifest.json').json.data;\nconst ups = [];\n$('Job').all().forEach((it, ji) => {\n  const job = it.json, spec = manifest.workflows[job.workflow];\n  for (const [key, value] of Object.entries(job.params)) {\n    if (spec.params[key] && spec.params[key][0][2] === 'image') ups.push({ json: { ji, key, path: value, server: job.server } });\n  }\n});\nreturn ups;\n"
      },
      "name": "List uploads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        460
      ],
      "id": "91a72095-f888-5bb8-9e4f-3149a5b7e42a"
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.path }}",
        "options": {}
      },
      "name": "Read input file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1320,
        460
      ],
      "id": "694b2288-3df6-55fd-b83f-02278a7ac6c4"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('List uploads').item.json.server }}/upload/image",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "image",
              "inputDataFieldName": "data"
            },
            {
              "name": "overwrite",
              "value": "true"
            },
            {
              "name": "subfolder",
              "value": "listing-heroes"
            }
          ]
        }
      },
      "name": "Upload to ComfyUI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        460
      ],
      "id": "a67dd630-ae15-506e-8406-7c847024cfcd"
    },
    {
      "parameters": {
        "jsCode": "// Give every job the names ComfyUI assigned its uploads (\"subfolder/name\"), keyed by param.\nconst metas = $('List uploads').all().map((x) => x.json);\nconst byJob = {};\n$input.all().forEach((it, k) => {\n  const m = metas[k];\n  (byJob[m.ji] = byJob[m.ji] || {})[m.key] = it.json.subfolder ? `${it.json.subfolder}/${it.json.name}` : it.json.name;\n});\nreturn $('Job').all().map((it, ji) => ({ json: Object.assign({}, it.json, { uploads: byJob[ji] || {} }) }));\n"
      },
      "name": "Collect uploads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        460
      ],
      "id": "55f48ae1-c557-5ed8-8963-9c5d958c00bb"
    },
    {
      "parameters": {
        "jsCode": "// Build the ComfyUI API prompt for one job: load the workflow, apply params (image params use the uploaded\n// names collected by the previous nodes), randomise seeds the caller didn't pin.\n// Runs once per item. Input item = the job plus uploads { paramName: 'subfolder/name' };\n// $('Parse workflow files') holds manifest.json and every workflow file.\nconst job = $input.item.json;\nconst files = {};\nfor (const it of $('Parse workflow files').all()) files[it.json.file] = it.json.data;\nconst manifest = files['manifest.json'];\nconst spec = manifest.workflows[job.workflow];\nif (!spec) throw new Error(`unknown workflow ${job.workflow}`);\nconst prompt = JSON.parse(JSON.stringify(files[spec.file]));\nconst byTitle = (t) => {\n  const id = Object.keys(prompt).find((k) => (prompt[k]._meta || {}).title === t);\n  if (!id) throw new Error(`${job.workflow}: no node titled \"${t}\"`);\n  return id;\n};\nconst uploads = job.uploads || {};\nfor (const [key, raw] of Object.entries(job.params)) {\n  const targets = spec.params[key];\n  if (!targets) throw new Error(`${job.workflow}: unknown param ${key}`);\n  const kind = targets[0][2];\n  let v = raw;\n  if (kind === 'image') v = uploads[key];\n  else if (kind === 'int') v = parseInt(raw, 10);\n  else if (kind === 'float') v = parseFloat(raw);\n  else if (kind === 'bool') v = ['1', 'true', 'yes', true].includes(raw);\n  for (const [title, field] of targets) prompt[byTitle(title)].inputs[field] = v;\n}\nif (!('seed' in job.params)) {\n  for (const node of Object.values(prompt)) {\n    for (const f of ['seed', 'noise_seed']) {\n      if (f in node.inputs && !Array.isArray(node.inputs[f])) node.inputs[f] = Math.floor(Math.random() * 2 ** 48);\n    }\n  }\n}\nreturn { json: Object.assign({}, job, { prompt_body: { prompt, client_id: 'listing-heroes-n8n' }, outputs: spec.outputs, titles: Object.fromEntries(Object.entries(spec.outputs).map(([label, t]) => [label, byTitle(t)])) }) };\n",
        "mode": "runOnceForEachItem"
      },
      "name": "Build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        460
      ],
      "id": "bc8b689a-f526-57e1-851e-208fe297c022"
    },
